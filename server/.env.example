# ── Admin credentials ────────────────────────────────────────────────────────
# The username you log in with.
ADMIN_USERNAME=admin
# EITHER set a plain password (simple)...
ADMIN_PASSWORD=change-me-please
# ...OR (preferred) a bcrypt hash generated with: npm run hash -- 'your-password'
# ADMIN_PASSWORD_HASH=

# Long random string used to sign login tokens. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── GitHub (where content.json is committed) ─────────────────────────────────
# A fine-grained Personal Access Token with "Contents: Read and write" on this repo.
GITHUB_TOKEN=ghp_xxx
GITHUB_OWNER=lotfi029
GITHUB_REPO=portfolio
GITHUB_BRANCH=main
CONTENT_PATH=public/content.json

# ── CORS ─────────────────────────────────────────────────────────────────────
# Restrict to your site's origin in production, e.g. https://lotfi029.github.io
ALLOWED_ORIGIN=*

# Port (most hosts set this automatically)
PORT=8787
